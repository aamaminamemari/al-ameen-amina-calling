# =====================================================================
# Standalone School Calling System - Environment Configuration
# Fill in the NEW school's own Neon DB, Cloudinary & Gateway details.
# =====================================================================

PORT=3000
SCHOOL_NAME=My School Calling Booth

# 1. New School's Neon PostgreSQL Connection String
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# 2. Random strong secret for login tokens (change this to any random string)
JWT_SECRET=change_this_to_a_random_secret_key_12345

# 3. New School's Cloudinary Account (for MP3 call recordings)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 4. Local VoIP Hardware Settings (Hostel PC)
SIP_PORT=5060
VOIP_GATEWAY_IP=192.168.0.240
VOIP_GATEWAY_PORT=30004
YEALINK_IP=192.168.0.210

# 5. Recording Auto-Delete Retention (days)
RECORDING_RETENTION_DAYS=90
